# syntax=docker/dockerfile:1
FROM node:20-alpine AS base
WORKDIR /app

# Install dependencies
FROM base AS deps
COPY server/package*.json ./
RUN npm ci --omit=dev

# Production runner
FROM base AS runner
ENV NODE_ENV=production
ENV PORT=5000

# Create app directory & non-root user
RUN addgroup -S tenderlens && adduser -S tenderlens -G tenderlens
RUN mkdir -p /app/uploads && chown -R tenderlens:tenderlens /app

WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY server/ ./

USER tenderlens

EXPOSE 5000
CMD ["node", "src/server.js"]
